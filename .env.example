# Example only. Do not upload real secrets to GitHub.
# Render should keep these values in its Environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-a-long-random-secret
# Configure only after confirming the exact AdGem postback signing requirements.
ADGEM_POSTBACK_KEY=replace-only-with-the-key-provided-by-AdGem
PORT=10000
